Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^(?:app|database|storage|vendor|tests|bin|plugin)(?:/|$) - [F,L,NC]
    RewriteRule ^public/assets/ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(sqlite|sql|log|env)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:composer\.(?:json|lock)|AGENTS\.md|README\.md)$">
    Require all denied
</FilesMatch>
